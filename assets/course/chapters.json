{
 "chapters": [
  {
   "number": 1,
   "title": "በገና ምንድን ነው?",
   "sections": [
    {
     "heading": null,
     "blocks": [
      {"type": "p", "text": "በገና በኢትዮጵያ ኦርቶዶክስ ተዋሕዶ ቤተ ክርስቲያን ከሚጠቀሙባቸው አውታር ካላቸው የዜማ መሳሪያዎች የሚመደብ ነው።"}
     ]
    }
   ]
  },
  {
   "number": 2,
   "title": "የበገና ታሪክ",
   "sections": [
    {
     "heading": null,
     "blocks": [
      {"type": "p", "text": "ዘፍ. 4፥21 — የላሜህ ልጅ ዩባል በገናንና መለከትን ለሚይዙ አባት ነበር።"}
     ]
    }
   ]
  },
  {
   "number": 3,
   "title": "የበገና አገልግሎት",
   "sections": [
    {
     "heading": null,
     "blocks": [
      {"type": "p", "text": "የበገና ጥቅሞች፦ እግዚአብሔርን ለማመስገንና ለጸሎት፣ መንፈሳዊ ሕይወትን ለማጠንከር፣ ለተመስጦ፣ ከኀዘን ለመጽናናት።"}
     ]
    }
   ]
  },
  {
   "number": 4,
   "title": "የበገና አካል ክፍሎችና ምሳሌያቸው",
   "sections": [
    {
     "heading": null,
     "blocks": [
      {"type": "p", "text": "በገና ከእንጨትና ከእንስሳት ተዋጽኦ (ቆዳ፣ አንጀት፣ ቀንድ) ይሠራል።"}
     ]
    }
   ]
  },
  {
   "number": 5,
   "title": "የበገና አያያዝና አደራደር",
   "sections": [
    {
     "heading": null,
     "blocks": [
      {"type": "p", "text": "በገና በግራ እጅ ጣቶች ይደረደራል (ትውፊቱ እንዲህ ነው)፤ ቀኝ እጅ በደረት በኩል ያለውን ምሰሶ ይደግፋል።"}
     ]
    }
   ]
  },
  {
   "number": 6,
   "title": "ቅኝት (ቀመር)",
   "sections": [
    {
     "heading": null,
     "blocks": [
      {"type": "p", "text": "ቅኝት የአንድ የዜማ ሥልት መሠረታዊ ድምጾችን ይዞ የሚገኝ ቀመር ነው፤ ቅኝት የሌለው ዜማ አይኖርም።"}
     ]
    }
   ]
  }
 ]
}
